# --- OpenRouter (all models: LLM + TTS) ---
OPENROUTER_API_KEY=

# Models (override as needed)
PLANNER_MODEL=anthropic/claude-sonnet-5.5
CALL_MODEL=google/gemini-3.8-flash
TTS_MODEL=google/gemini-3.8-flash-tts
TTS_VOICE=Kore

# --- Twilio (trial is fine; trial can only call verified numbers) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Phone the agent calls as "the payer" in the demo (must be verified on a Twilio trial)
DEMO_TO_NUMBER=

# --- Server ---
PORT=8787
# Public HTTPS URL Twilio can reach (from `npm run tunnel`, e.g. https://xxxx.trycloudflare.com)
PUBLIC_URL=
# "twilio" = real phone calls, "sim" = simulated callee typed in the app (no Twilio needed)
CALL_MODE=sim

# Max phone calls the agent may place per errand run (prevents redialing)
MAX_CALLS_PER_ERRAND=1

# Twilio API key (signs Voice SDK access tokens for in-app handoff)
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# Policy engine (appeal analysis) model
ENGINE_MODEL=anthropic/claude-sonnet-5.5

# Optional: fall back to Twilio <Say> if TTS takes longer than this (ms)
# TTS_DEADLINE_MS=3500
